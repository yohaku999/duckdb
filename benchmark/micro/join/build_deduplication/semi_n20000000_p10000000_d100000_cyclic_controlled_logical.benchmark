# name: benchmark/micro/join/build_deduplication/semi_n20000000_p10000000_d100000_cyclic_controlled_logical.benchmark
# description: semi_n20000000_p10000000_d100000_cyclic_controlled_logical
# group: [build_deduplication]

template benchmark/micro/join/build_deduplication/build_deduplication.benchmark.in
MODE=logical
BUILD_ROWS=20000000
PROBE_ROWS=10000000
NDV=100000
BUILD_EXPRESSION=i % 100000
ORDER_BY=/* preserve input order */
SETUP=SET perfect_ht_threshold TO 0; SET disabled_optimizers TO 'build_side_probe_side';
QUERY=SELECT count(*) FROM probe p SEMI JOIN build b USING (k)
EXPECTED=5000000
