# name: benchmark/micro/join/build_deduplication/anti_n2000000_p4000000_d2000000_cyclic_natural_physical.benchmark
# description: anti_n2000000_p4000000_d2000000_cyclic_natural_physical
# group: [build_deduplication]

template benchmark/micro/join/build_deduplication/build_deduplication.benchmark.in
MODE=physical
BUILD_ROWS=2000000
PROBE_ROWS=4000000
NDV=2000000
BUILD_EXPRESSION=i % 2000000
ORDER_BY=/* preserve input order */
SETUP=SET enable_progress_bar TO false;
QUERY=SELECT count(*) FROM probe p ANTI JOIN build b USING (k)
EXPECTED=2000000
