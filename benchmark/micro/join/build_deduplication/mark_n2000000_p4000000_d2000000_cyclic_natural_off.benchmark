# name: benchmark/micro/join/build_deduplication/mark_n2000000_p4000000_d2000000_cyclic_natural_off.benchmark
# description: mark_n2000000_p4000000_d2000000_cyclic_natural_off
# group: [build_deduplication]

template benchmark/micro/join/build_deduplication/build_deduplication.benchmark.in
MODE=off
BUILD_ROWS=2000000
PROBE_ROWS=4000000
NDV=2000000
BUILD_EXPRESSION=i % 2000000
ORDER_BY=/* preserve input order */
SETUP=SET enable_progress_bar TO false;
QUERY=SELECT sum(CASE WHEN k IN (SELECT k FROM build) THEN 1 ELSE 0 END) FROM probe
EXPECTED=2000000
