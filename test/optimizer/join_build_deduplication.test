# name: test/optimizer/join_build_deduplication.test
# description: Experimental logical and physical existence-join build deduplication
# group: [optimizer]

statement ok
SET disabled_optimizers = 'build_side_probe_side';

statement ok
SET perfect_ht_threshold = 0;

statement ok
CREATE TABLE dedup_probe(id INTEGER, k BIGINT);

statement ok
INSERT INTO dedup_probe VALUES (1, 1), (2, 1), (3, 2), (4, NULL), (5, 3);

statement ok
CREATE TABLE dedup_build(k BIGINT);

statement ok
INSERT INTO dedup_build VALUES (1), (1), (NULL), (NULL), (3), (3);

foreach threads 1 4

statement ok
SET threads = {threads};

foreach mode off logical physical

statement ok
SET VARIABLE join_build_deduplication = '{mode}';

# Preserve duplicate probe rows and SQL's different ANTI / NOT IN null semantics.
query I rowsort
SELECT p.id FROM dedup_probe p SEMI JOIN dedup_build b ON p.k = b.k;
----
1
2
5

query I rowsort
SELECT p.id FROM dedup_probe p ANTI JOIN dedup_build b ON p.k = b.k;
----
3
4

query III rowsort
SELECT id, k IN (SELECT k FROM dedup_build), k NOT IN (SELECT k FROM dedup_build) FROM dedup_probe;
----
1	true	false
2	true	false
3	NULL	NULL
4	NULL	NULL
5	true	false

query I rowsort
SELECT p.id FROM dedup_probe p SEMI JOIN dedup_build b ON p.k IS NOT DISTINCT FROM b.k;
----
1
2
4
5

query II rowsort
SELECT id, k IN (SELECT k FROM dedup_build WHERE false) FROM dedup_probe;
----
1	false
2	false
3	false
4	false
5	false

query II rowsort
SELECT id, k IN (SELECT k FROM dedup_build WHERE k IS NULL) FROM dedup_probe;
----
1	NULL
2	NULL
3	NULL
4	NULL
5	NULL

# Deduplicate the completed LIMIT/OFFSET result, rather than its input.
query I rowsort
SELECT p.id FROM dedup_probe p SEMI JOIN
(SELECT k FROM dedup_build WHERE k IS NOT NULL ORDER BY k LIMIT 2) b ON p.k = b.k;
----
1
2

query I rowsort
SELECT p.id FROM dedup_probe p SEMI JOIN
(SELECT k FROM dedup_build WHERE k IS NOT NULL ORDER BY k LIMIT 2 OFFSET 2) b ON p.k = b.k;
----
5

# Evaluate volatile input expressions once per original input row.
statement ok
CREATE SEQUENCE dedup_sequence START 1;

query I rowsort
SELECT p.id FROM dedup_probe p SEMI JOIN
(SELECT nextval('dedup_sequence') AS k FROM range(3)) b ON p.k = b.k;
----
1
2
3
5

query I
SELECT currval('dedup_sequence');
----
3

statement ok
DROP SEQUENCE dedup_sequence;

# Additional predicates and multi-key / correlated joins retain the existing path.
query I rowsort
SELECT p.id FROM dedup_probe p SEMI JOIN dedup_build b ON p.k = b.k AND p.id < b.k;
----

query I rowsort
SELECT id FROM dedup_probe p WHERE EXISTS
(SELECT 1 FROM dedup_build b WHERE b.k = p.k LIMIT 1 OFFSET 1);
----
1
2
5

query I
SELECT count(*) FROM (VALUES ('x'), ('x'), ('y')) p(k)
SEMI JOIN (VALUES ('x'), ('x')) b(k) ON p.k = b.k;
----
2

# Growth and hash collisions must never lose a key.
query I
SELECT count(*) FROM range(100000) p(k)
SEMI JOIN (SELECT i % 100000 AS k FROM range(200000) b(i)) b ON p.k = b.k;
----
100000

query I
SELECT count(*) FROM range(20) p(k)
SEMI JOIN (SELECT i % 10 AS k FROM range(300000) b(i)) b ON p.k = b.k;
----
10

# A reused sink must forget keys from the previous recursive iteration.
query I
WITH RECURSIVE r(i, k) AS (
    SELECT 1, 1::BIGINT
    UNION ALL
    SELECT r.i + 1, r.k FROM r SEMI JOIN dedup_build b ON r.k = b.k WHERE r.i < 3
)
SELECT count(*) FROM r;
----
3

statement ok
SET debug_force_external = true;

query I
SELECT count(*) FROM range(20000) p(k)
SEMI JOIN (SELECT i % 10000 AS k FROM range(200000) b(i)) b ON p.k = b.k;
----
10000

query I
SELECT sum(CASE WHEN k IN (
    SELECT CASE WHEN i % 10 = 0 THEN NULL ELSE i % 10 END FROM range(200000) b(i)
) THEN 1 ELSE 0 END) FROM range(20) p(k);
----
9

statement ok
SET debug_force_external = false;

query I
SELECT count(*) FROM (VALUES ('-9223372036854775808'::BIGINT), (-1::BIGINT)) p(k)
SEMI JOIN (VALUES ('-9223372036854775808'::BIGINT), (-1::BIGINT), (-1::BIGINT)) b(k) ON p.k = b.k;
----
2

query I
SELECT count(*) FROM (VALUES (18446744073709551615::UBIGINT), (0::UBIGINT)) p(k)
SEMI JOIN (VALUES (18446744073709551615::UBIGINT), (18446744073709551615::UBIGINT), (0::UBIGINT)) b(k)
ON p.k = b.k;
----
2

endloop

endloop

require no_alternative_verify

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
SET explain_output = 'optimized_only';

statement ok
SET VARIABLE join_build_deduplication = 'logical';

query TT
EXPLAIN SELECT p.id FROM dedup_probe p SEMI JOIN dedup_build b ON p.k = b.k;
----
logical_opt	<REGEX>:.*DISTINCT.*

statement ok
SET VARIABLE join_build_deduplication = 'physical';

query TT
EXPLAIN SELECT p.id FROM dedup_probe p SEMI JOIN dedup_build b ON p.k = b.k;
----
logical_opt	<!REGEX>:.*DISTINCT.*

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('PhysicalOperator');

query I
SELECT count(*) FROM range(20) p(k)
SEMI JOIN (SELECT i % 10 AS k FROM range(300000) b(i)) b ON p.k = b.k;
----
10

statement ok
CALL disable_logging();

# Physical mode must actually suppress materialized build rows.
query I
SELECT sum(info.rows::BIGINT) < 300000 FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class = 'JoinHashTable' AND event = 'Build';
----
true

statement ok
SET threads = 1;

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('PhysicalOperator');

# Growth must retain all 100,000 distinct keys, including colliding keys.
query I
SELECT count(*) FROM range(100000) p(k)
SEMI JOIN (SELECT i % 100000 AS k FROM range(1000000) b(i)) b ON p.k = b.k;
----
100000

statement ok
CALL disable_logging();

query I
SELECT sum(info.rows::BIGINT) FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class = 'JoinHashTable' AND event = 'Build';
----
100000

# Exceeding the set's capacity falls back to the normal Build.
query I
SELECT count(*) FROM range(300000) p(k)
SEMI JOIN (SELECT i % 300000 AS k FROM range(600000) b(i)) b ON p.k = b.k;
----
300000

statement ok
SET memory_limit = '64MB';

statement ok
SET threads = 4;

# The memory budget can force an earlier fallback without changing the result.
query I
SELECT count(*) FROM range(20000) p(k)
SEMI JOIN (SELECT i % 10000 AS k FROM range(200000) b(i)) b ON p.k = b.k;
----
10000

statement ok
RESET memory_limit;
